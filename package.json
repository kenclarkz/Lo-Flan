{
  "name": "los-flan",
  "version": "1.0.0",
  "private": true,
  "description": "Lo's Flan — a cinematic, luxury handmade flan bakery experience.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "app:build": "BUILD_TARGET=app next build",
    "app:sync": "BUILD_TARGET=app next build && npx cap sync",
    "app:ios": "BUILD_TARGET=app next build && npx cap sync ios && npx cap open ios",
    "app:electron": "BUILD_TARGET=app next build && npx cap sync @capacitor/electron && npx cap open @capacitor/electron",
    "receptionist:dev": "npm --prefix server run dev",
    "receptionist:start": "npm --prefix server run start",
    "receptionist:test": "npm --prefix server test"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/electron": "^2.5.0",
    "@capacitor/ios": "^8.5.0",
    "@gsap/react": "2.1.1",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "clsx": "2.1.1",
    "gsap": "3.12.5",
    "lenis": "1.1.14",
    "lucide-react": "0.452.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
