# ─────────────────────────────────────────────────────────────
# Lo's Flan — AI Receptionist (Stage 1)
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or real API keys.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# Port the backend listens on.
PORT=8080

# Public HTTPS base URL of this backend, e.g. your ngrok URL.
# Used to build the `wss://` Media Streams URL that Twilio connects to.
# If empty, the server derives it from each request's Host header
# (handy behind ngrok/reverse proxies that set X-Forwarded-Proto).
APP_BASE_URL=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Google AI (Gemini Live — free tier) ─────────────────────
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live voice model (free tier supports the Live preview models).
GEMINI_LIVE_MODEL=gemini-2.5-flash-live-preview

# Gemini Live voice name (Puck, Kore, Zephyr, Charon, Aoede, ...).
GEMINI_VOICE=Puck

# ── Admin orders API ──────────────────────────────────────────────
# Shared secret that guards GET /api/orders and friends. The admin
# dashboard sends it as the `X-Admin-Key` header. Keep it secret and
# unique — treat it like a password.
ADMIN_API_KEY=

# JSON file where recorded orders/calls are persisted. Defaults to
# ./data/orders.json relative to the server package.
ORDERS_FILE=

# ── PostgreSQL ────────────────────────────────────────────────
# Connection string for the orders database. When set, orders are
# stored in PostgreSQL instead of the JSON file.
DATABASE_URL=postgresql://loflan:loflan_dev@localhost:5432/loflan_orders

# ── Twilio ──────────────────────────────────────────────────
# Used to verify inbound webhook signatures (optional, see README).
TWILIO_AUTH_TOKEN=
# Set to true to enable signature verification of Twilio webhooks.
VERIFY_TWILIO_SIGNATURES=false

# ── Receptionist ────────────────────────────────────────────
# Spoken by Twilio's text-to-speech before the AI stream connects.
GREETING_MESSAGE=Thanks for calling Lo's Flan! I'm the AI receptionist. How can I help you today?

# Spoken when the backend can't start the AI (missing key, etc.).
UNAVAILABLE_MESSAGE=Sorry, the AI receptionist is unavailable right now. Please try again later or send us a message through our website.
